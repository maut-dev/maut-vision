<Window x:Class="MautVision.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Maut Vision"
        Icon="Assets/maut-vision.ico"
        WindowStartupLocation="CenterScreen" Background="#09090b">
  <Grid>
    <wv:WebView2 x:Name="Browser" DefaultBackgroundColor="#09090b" />
    <TextBlock x:Name="StartupMessage" Foreground="#a1a1aa"
               FontFamily="Segoe UI" HorizontalAlignment="Center" VerticalAlignment="Center"
               TextWrapping="Wrap" MaxWidth="500" Margin="32" />
  </Grid>
</Window>
