<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only the notification area icon (NotifyIcon) comes from WinForms; its names are not imported globally, WPF keeps its own. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>MautVision.Desktop</AssemblyName>
    <RootNamespace>MautVision.Desktop</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ApplicationIcon>Assets/maut-vision.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF takes per-monitor DPI awareness only from the manifest; the WinForms advice (ApplicationHighDpiMode) concerns WinForms entry points. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <SatelliteResourceLanguages>ru;en</SatelliteResourceLanguages>
  </PropertyGroup>
  <!-- Only dotnet publish (the installer payload): a self-contained ReadyToRun build. Trimming and single-file break WPF, WinForms and WebView2.
       A global -p:PublishReadyToRun=false or -p:PublishReadyToRunComposite=true overrides these for measurements. -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../MautVision.Core/MautVision.Core.csproj" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <!-- The local MCP server (Mcp/): the official C# SDK with its Streamable HTTP transport on Kestrel (Microsoft.AspNetCore.App). Loaded only when
         the user turns the server on. -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.3.0" />
    <!-- English texts of error codes for MCP answers: the same catalog the UI shows, embedded at build time. -->
    <EmbeddedResource Include="../../ui/src/locales/en/errors.json" LogicalName="MautVision.Desktop.Mcp.errors.en.json" Link="Mcp/errors.en.json" />
    <Resource Include="Assets/logo-full.png;Assets/maut-vision.ico" />
    <Content Include="../../ui/dist/**/*" Link="web/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../catalog/**/*" Link="catalog/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- The pinned LGPL ffmpeg build (ffmpeg.exe, ffprobe.exe, their av*/sw* DLLs, licence) fetched by tools/get-ffmpeg.ps1 into .dev/tools/ffmpeg (not in git). -->
    <Content Include="../../.dev/tools/ffmpeg/*.exe;../../.dev/tools/ffmpeg/*.dll;../../.dev/tools/ffmpeg/*.txt" Link="tools/ffmpeg/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('../../.dev/tools/ffmpeg/ffmpeg.exe')" />
    <!-- AGPL-3.0 text and the notices of the third-party components with the source code address. -->
    <Content Include="../../LICENSE;../../THIRD-PARTY-NOTICES.txt" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../appdata/**/*" Exclude="../../appdata/**/.gitkeep" Link="appdata/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
