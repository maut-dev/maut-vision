<Window x:Class="MautVision.Desktop.LoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Maut Vision" Width="420" Height="360" ResizeMode="NoResize"
        Icon="Assets/maut-vision.ico"
        WindowStartupLocation="CenterScreen" Background="#09090b">
    <StackPanel Margin="40" VerticalAlignment="Center">
        <Image Source="Assets/logo-full.png" Width="200" Height="200" Margin="0,0,0,8"
               RenderOptions.BitmapScalingMode="HighQuality" />
        <TextBlock x:Name="Message" FontFamily="Segoe UI" FontSize="14"
                   Foreground="#a1a1aa" HorizontalAlignment="Center" />
    </StackPanel>
</Window>
