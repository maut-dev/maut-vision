<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!-- The one version of the release: assemblies, the exe file properties, the log and the installer (build-installer.ps1 passes it to /DAppVersion). -->
    <Version>1.0.0</Version>
    <Company>Maut Vision</Company>
    <Product>Maut Vision</Product>
  </PropertyGroup>
</Project>
